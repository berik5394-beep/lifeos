{
  "name": "lifeos",
  "version": "2.0.0-alpha",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run --workspace=apps/mobile start",
    "server": "npm run --workspace=packages/server dev",
    "server:build": "npm run --workspace=packages/server build"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "expo-dev-client": "~6.0.20",
    "react-native-reanimated": "^4.1.7"
  }
}
