# ============================================================================
# LifeOS Server — Environment Variables
# Скопируй этот файл в `.env` и заполни реальными значениями.
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Строка подключения к PostgreSQL (Prisma). На Railway — берётся автоматом.
DATABASE_URL=postgresql://user:password@localhost:5432/lifeos

# ----------------------------------------------------------------------------
# Auth
# ----------------------------------------------------------------------------
# Секрет для подписи JWT-токенов. МИНИМУМ 32 символа — иначе сервер не стартует.
# Сгенерировать: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Ключ для шифрования access/refresh токенов интеграций в БД (AES-256).
# Ровно 32 символа (или 64 hex). Сгенерировать: `openssl rand -hex 32`
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ----------------------------------------------------------------------------
# AI providers
# ----------------------------------------------------------------------------
# Claude API (Anthropic) — NLU, диалог с ассистентом, чат, парсинг импорта.
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API — Whisper STT (распознавание русской речи).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# Integrations
# ----------------------------------------------------------------------------
# Telegram бот (@LifeOS_bot). Получить у @BotFather. Если пусто — бот не запускается.
TELEGRAM_BOT_TOKEN=123456789:AAEexampleExampleExampleExampleExampleEx

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
# Режим запуска: `development` | `production`. Влияет на CORS dev-fallback
# и на то, включать ли stack traces в ответы об ошибках.
NODE_ENV=development

# Порт HTTP-сервера. На Railway подставляется автоматически.
PORT=3000

# CORS whitelist — список разрешённых origin'ов через запятую.
# В dev можно оставить пустым (localhost/Expo разрешены автоматически).
# В проде — строго перечислить домены мобильных клиентов / веба.
CORS_ORIGINS=https://app.lifeos.kz,https://lifeos.kz

# ----------------------------------------------------------------------------
# AI cost guard
# ----------------------------------------------------------------------------
# Максимум AI-вызовов (Claude + Groq + Vision) на одного юзера в сутки.
# Делится между всеми AI-эндпоинтами (chat, voice, vision, import, prioritize...).
# Защита от drain'а кошелька при багах клиента или злоупотреблении.
# По умолчанию 200 — хватает для активного тестера, не разоряет на 10 юзерах.
AI_DAILY_LIMIT=200
