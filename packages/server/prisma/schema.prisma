generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  currency        String   @default("₸")
  assistantStyle  String   @default("friendly")
  assistantGender String   @default("female")
  wakeUpTime      String   @default("07:00")
  // B.5: таймзона юзера для корректного «сегодня» (аудит 2.7 —
  // сейчас весь date-math на серверном UTC, для Алматы UTC+5 после
  // 19:00 локально считается «завтра»). Дефолт — Алматы (KZ-приложение).
  timezone        String   @default("Asia/Almaty")
  // Phase 6 C5 — явный opt-out терапевтического режима. По умолчанию
  // ON (north star — заботливый друг); false → юзер получает только
  // транзакционные ответы (productivity-режим), эмо-классификатор
  // игнорируется, therapeutic-детекторы не эмитят. Аддитивно с
  // default(true) — миграция безопасна (ISSUE-X).
  therapeuticMode Boolean  @default(true)
  // Phase 7 P1 — DND quiet hours. Формат "HH:MM" локально (по User.timezone).
  // null = DND off. Если start > end (например 23:00→08:00) — интервал
  // пересекает полночь. Centralized check в push-service.ts:deliverNotification.
  // Additive only (см. AGENTS.md §3).
  quietHoursStart String?
  quietHoursEnd   String?
  settings        Json     @default("{}")
  createdAt       DateTime @default(now())

  habits                 Habit[]
  habitLogs              HabitLog[]
  tasks                  Task[]
  weeklyGoals            WeeklyGoal[]
  yearlyGoals            YearlyGoal[]
  expenses               Expense[]
  incomes                Income[]
  journalEntries         JournalEntry[]
  stepLogs               StepLog[]
  importedFiles          ImportedFile[]
  events                 CalendarEvent[]
  budgetLimits           BudgetLimit[]
  chatMessages           ChatMessage[]
  integrations           Integration[]
  pet                    Pet?
  achievements           Achievement[]
  interests              UserInterest[]
  arenaProfile           ArenaProfile?
  refreshTokens          RefreshToken[]
  conversationSessions   ConversationSession[]
  travelPlans            TravelPlan[]
  contactCache           ContactCache[]
  documentVault          DocumentVault[]
  tags                   Tag[]
  sharedSpaceMemberships SharedSpaceMember[]
  ownedSpaces            SharedSpace[]         @relation("OwnedSpaces")
  memories               Memory[]
  dictationSessions      DictationSession[]
  uiComplexity           String                @default("standard")
  // v2.0 — Tier 3+4+5 reverse relations
  entities               Entity[]
  entityRelations        EntityRelationship[]
  patterns               Pattern[]
  moodSnapshots          MoodSnapshot[]
  botIdentity            BotIdentity?
  /// @deprecated P0 billing: фейковая подписка (роут+subscription.ts)
  /// УДАЛЕНА — это и есть P0-фикс, код НЕ трогаем. Колонки —
  /// ОРФАНЫ, никто не читает. Оставлены живыми т.к. деплой =
  /// `prisma db push` без --accept-data-loss (Dockerfile): DROP =
  /// data-loss → push exit≠0 → `&& node` не стартует → healthcheck
  /// падает (инцидент 2026-05-18). Реальный DROP блокирован до
  /// ISSUE-X (cutover db push → migrate deploy); см. ISSUE-Y в
  /// docs/migration/ISSUES.md. НЕ читать, НЕ писать эти поля.
  subscriptionTier       String                @default("free")
  /// @deprecated орфан, см. subscriptionTier выше / ISSUE-Y.
  subscriptionExpiresAt  DateTime?
  // Expo push token мобильного приложения (основной канал проактивных
  // уведомлений). App-first: пушим в приложение, бота зеркалим.
  expoPushToken          String?
  sentNotifications      SentNotification[]
  insights               Insight[]
  // P3/R7 — настройка рефлектора под юзера (learning-loop): какие
  // типы инсайтов реже/замьючены (3× dismiss → реже). Json, чтобы
  // не плодить колонки. Аддитивно (правило ISSUE-X).
  reflectorTuning        Json?
  // Phase 6 C2 — синтезированный «характер» (ПРОИЗВОДНАЯ вьюха над
  // Memory, не параллельная память: Memory = SSOT).
  userProfile            UserProfile?
  // v2.0 Phase B1 — USER NEST axes
  userAxes               UserAxes?
  axisSignals            AxisSignal[]
  // v2.0 Phase B2 — Identity Evolution: weekly trait snapshots
  botTraitSnapshots      BotTraitSnapshot[]
  // v2.0 Phase B3 — Cross-Session Learning: feedback-loop audit
  correctionLogs         CorrectionLog[]
  // v2.0 Phase B4 — Hermes composable skills
  skills                 SkillDefinition[]
}

// Phase 6 C2 — синтезированный профиль личности. ВАЖНО (#4 SSOT):
// это НЕ источник правды и НЕ вторая память — это регенерируемый
// КЭШ еженедельного синтеза над Memory(+ChatMessage crisis=false+
// completed tasks/habits + reflector Insights). Удаление строки
// безопасно (пересинтезируется). Кризис-сообщения НЕ участвуют
// (C1(d) инвариант: синтезатор фильтрует crisis=false).
model UserProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // ["family-oriented","career-driven",...]
  values            Json      @default("[]")
  // ["criticism","money pressure",...]
  triggers          Json      @default("[]")
  // ["abandons habits week 3",...]
  patterns          Json      @default("[]")
  // "direct, no fluff, ценит конкретику"
  styleNotes        String?
  // {"мама":"сложно, но люблю","Серик":"бизнес"}
  relationships     Json      @default("{}")
  lastSynthesizedAt DateTime?
  // для будущих миграций структуры синтеза
  synthesisVersion  Int       @default(0)
  updatedAt         DateTime  @updatedAt
}

// Дедуп проактивных уведомлений: планировщик тикает каждые ~10 мин и
// не должен слать одно и то же повторно. Уникальность по (user, type,
// scheduledFor) — если запись есть, уведомление уже отправлено.
model SentNotification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // event_reminder_1h | budget_alert | habit_nudge | ...
  scheduledFor DateTime
  sentAt       DateTime @default(now())
  channel      String   @default("push") // push | telegram | both

  @@unique([userId, type, scheduledFor])
  @@index([userId, sentAt])
}

// Хранилище refresh-токенов для ротации и отзыва.
// При каждом /auth/refresh старый токен помечается revoked=true и выдаётся новый.
// При выходе пользователя — все его токены отзываются.
// Если кто-то попытается использовать уже отозванный токен → отозвать ВСЕ
// (это значит refresh-токен утёк, нужно разлогинить пользователя везде).
model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Хэш токена (SHA-256), не сам токен — даже при компрометации БД злоумышленник
  // не сможет использовать токены без знания исходных значений.
  tokenHash  String   @unique
  // Когда токен истекает (после этой даты он автоматически невалиден)
  expiresAt  DateTime
  // Был ли токен использован/отозван
  revoked    Boolean  @default(false)
  // ID токена, которым этот был заменён (для аудита цепочки ротации)
  replacedBy String?
  // Метаданные клиента (для аудита подозрительной активности)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserInterest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  topic         String
  score         Float    @default(1)
  lastMentioned DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([userId, topic])
  @@index([userId])
}

model Habit {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  name         String
  category     String
  frequency    String
  goalId       String?
  goal         YearlyGoal? @relation(fields: [goalId], references: [id])
  autoComplete Json?
  order        Int         @default(0)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  logs         HabitLog[]

  // Phase 5 P1 — планировочное дерево (planner-service).
  // Дискриминатор БЕЗ DB-FK: parent может быть в ДРУГОЙ таблице
  // (YearlyGoal/WeeklyGoal/Task) — у Prisma нет полиморфного FK,
  // целостность на уровне приложения (диаграмма допускает).
  // goalId (выше) — legacy ручная привязка к цели, остаётся;
  // planParentId — новое generic-дерево декомпозиции.
  // planParentType ∈ 'YearlyGoal'|'WeeklyGoal'|'Task'.
  // derivedFrom ∈ 'user'|'planner'|'imported' — кто создал.
  planParentId   String?
  planParentType String?
  derivedFrom    String    @default("user")
  // Phase 5 P2 4/5 — re-decompose архивирует planner-привычку
  // (archivedAt), не удаляет. Habit.createdAt уже есть выше.
  archivedAt     DateTime?

  @@index([userId])
  @@index([planParentId])
}

model HabitLog {
  id            String   @id @default(cuid())
  habitId       String
  habit         Habit    @relation(fields: [habitId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  date          DateTime @db.Date
  completed     Boolean  @default(false)
  autoCompleted Boolean  @default(false)

  @@unique([habitId, date])
  @@index([userId, date])
}

model Task {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  title            String
  category         String
  priority         String
  date             DateTime         @db.Date
  time             String?
  completed        Boolean          @default(false)
  notes            String?
  createdAt        DateTime         @default(now())
  parentId         String?
  parent           Task?            @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks         Task[]           @relation("TaskSubtasks")
  estimatedMinutes Int?
  recurrence       String?
  kanbanStatus     String           @default("todo")
  urgency          Int?
  importance       Int?
  aiScore          Float?
  sharedSpaceId    String?
  sharedSpace      SharedSpace?     @relation(fields: [sharedSpaceId], references: [id])
  taskTags         TaskTag[]
  dependsOn        TaskDependency[] @relation("DependentTask")
  dependedBy       TaskDependency[] @relation("PrerequisiteTask")

  // Phase 5 P1 — планировочное дерево. ВАЖНО: parentId выше — это
  // self-FK САБТАСКОВ (Task→Task), его НЕ трогаем. planParentId —
  // ОТДЕЛЬНОЕ generic-дерево декомпозиции (parent может быть
  // WeeklyGoal/YearlyGoal в другой таблице, потому без FK).
  planParentId   String?
  planParentType String?
  derivedFrom    String  @default("user")

  @@index([userId, date])
  @@index([userId, kanbanStatus])
  @@index([parentId])
  @@index([sharedSpaceId])
  @@index([planParentId])
}

model WeeklyGoal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime @db.Date
  goalText  String
  completed Boolean  @default(false)
  order     Int      @default(0)

  // Phase 5 P1 — планировочное дерево (см. Habit). Обычно
  // planParentType='YearlyGoal' (год → неделя).
  planParentId   String?
  planParentType String?
  derivedFrom    String    @default("user")
  // Phase 5 P2 4/5 — re-decompose: при смене цели старых planner-
  // детей АРХИВИРУЕМ (archivedAt=now), не удаляем (прогресс/история
  // целы). Активные = archivedAt:null. createdAt — для истинного
  // planStale (цель изменена ПОСЛЕ постройки плана).
  createdAt      DateTime  @default(now())
  archivedAt     DateTime?

  @@index([userId, weekStart])
  @@index([planParentId])
}

model YearlyGoal {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  year     Int
  area     String
  goalText String
  progress Float   @default(0)
  habits   Habit[]

  // Phase 5 P2 — pacing для декомпозиции (Option E + custom).
  // target — числовая величина цели если есть (50 книг, 1_000_000 ₸,
  // 10 кг); null = неизмеримая прозой.
  // pacingMode 'uniform' = равномерно, квартал/неделя СЧИТАЮТСЯ на
  // лету (хранить нечего). 'custom' = неравномерная кривая (вес,
  // спорт, деньги с нестабильным доходом) → планировщик пишет явные
  // milestone'ы в pacingPlan (JSON, БЕЗ отдельной таблицы Milestone;
  // если понадобится — мигрируем из JSON одной командой).
  target     Float?
  targetDate DateTime? // срок фин-цели для коуча; null → адаптер берёт 31 дек
  pacingMode String @default("uniform")
  pacingPlan Json?

  // Phase 5 P1 — корень дерева обычно (planParentId=null,
  // derivedFrom='user'); планировщик вешает на него WeeklyGoal/
  // Habit/Task через их planParentId. Поля для единообразия и
  // на случай мета-целей (цель → подцель).
  planParentId   String?
  planParentType String?
  derivedFrom    String   @default("user")
  // Phase 5 P2 4/5 — истинный planStale: цель изменена ПОЗЖЕ
  // постройки плана ⟺ updatedAt > max(active planner-child.createdAt).
  // @updatedAt — Prisma сам трогает при апдейте YearlyGoal.
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([userId, year])
  @@index([planParentId])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @db.Date
  category    String
  description String
  amount      Float
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model Income {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  source    String
  amount    Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @db.Date
  sleepHours Float?
  energy     Int?
  mood       Int?
  notes      String?

  @@unique([userId, date])
}

model StepLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @db.Date
  steps      Int
  distanceKm Float?
  gpsTrack   Json?

  @@unique([userId, date])
}

model ImportedFile {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  fileName   String
  fileType   String
  purpose    String
  parsedData Json
  createdAt  DateTime @default(now())

  @@index([userId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  date        DateTime @db.Date
  startTime   String?
  endTime     String?
  location    String?
  description String?
  reminder    Int      @default(30)
  source      String   @default("manual")
  // Phase 3.1: ID события во внешней системе (Google Calendar event id).
  // NULL = создано локально и ещё не запушено. Дедуп двусторонней
  // синхронизации идёт по (userId, externalId).
  externalId  String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([userId, externalId])
}

model BudgetLimit {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id])
  category     String
  monthlyLimit Float
  month        Int
  year         Int

  @@unique([userId, category, month, year])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String
  content   String
  actions   Json?
  createdAt DateTime @default(now())
  // Phase 6 C1 Safety — sensitive-флаг кризисного диалога. Ставится
  // ПОСТОЯННО при сохранении (нельзя «отменить» — для будущего
  // аудита, провал-инвариант спеки #6). Изолирует строку:
  // исключается из analytics/export, retention 30 дней (purge-cron),
  // at-rest шифрование. nullable не нужен — default false,
  // миграция аддитивна (IF NOT EXISTS, ISSUE-X-safe).
  crisis    Boolean  @default(false)

  @@index([userId, createdAt])
  // Purge-cron (retention 30д кризисных) + analytics-exclusion фильтр.
  @@index([crisis, createdAt])
}

model Integration {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  provider     String
  accessToken  String?
  refreshToken String?
  settings     Json     @default("{}")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, provider])
}

model Pet {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  type           String    @default("cat")
  characterType  String    @default("warrior")
  name           String    @default("LifePet")
  health         Float     @default(80)
  happiness      Float     @default(80)
  level          Int       @default(1)
  xp             Int       @default(0)
  xpToNext       Int       @default(100)
  stage          String    @default("baby")
  streak         Int       @default(0)
  // A.1: дата, за которую стрик последний раз оценён (раз/день,
  // идемпотентно). Раньше Pet.streak НИКОГДА не писался → вся
  // мета-игра (костюмы/бейджи/powerScore) была мертва.
  streakDate     DateTime? @db.Date
  mana           Int       @default(0)
  maxMana        Int       @default(100)
  isAlive        Boolean   @default(true)
  diedAt         DateTime?
  lastFed        DateTime  @default(now())
  lastPlayed     DateTime  @default(now())
  lastActive     DateTime  @default(now())
  costume        String?
  roomLevel      Int       @default(1)
  equippedHelmet String?
  equippedArmor  String?
  equippedWeapon String?
  equippedShield String?
  equippedBoots  String?
  equippedAura   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  items          PetItem[]
}

model PetItem {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id])
  itemKey    String
  name       String
  slot       String
  rarity     String   @default("common")
  bonus      String?
  bonusValue Float    @default(0)
  unlockedAt DateTime @default(now())

  @@unique([petId, itemKey])
  @@index([petId])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  key        String
  unlockedAt DateTime @default(now())
  claimed    Boolean  @default(false)

  @@unique([userId, key])
  @@index([userId])
}

// ===== PVP ARENA SYSTEM =====

model ArenaProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  trophies      Int       @default(0)
  wins          Int       @default(0)
  losses        Int       @default(0)
  draws         Int       @default(0)
  winStreak     Int       @default(0)
  bestWinStreak Int       @default(0)
  rank          String    @default("bronze")
  powerScore    Float     @default(0)
  lastBattleAt  DateTime?
  seasonWins    Int       @default(0)
  seasonLosses  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  battlesAsAttacker Battle[] @relation("attacker")
  battlesAsDefender Battle[] @relation("defender")
}

model Battle {
  id         String       @id @default(cuid())
  attackerId String
  attacker   ArenaProfile @relation("attacker", fields: [attackerId], references: [id])
  defenderId String
  defender   ArenaProfile @relation("defender", fields: [defenderId], references: [id])
  winnerId   String?

  attackerPower Float
  defenderPower Float
  attackerRoll  Float
  defenderRoll  Float

  attackerChar  String
  defenderChar  String
  attackerLevel Int
  defenderLevel Int

  trophyChange Int @default(0)
  xpReward     Int @default(0)

  battleType  String  @default("power") // "power" | "challenge"
  challengeId String?
  log         String?

  createdAt DateTime @default(now())

  @@index([attackerId])
  @@index([defenderId])
  @@index([createdAt])
}

// ===== PHYSICAL CHALLENGES (MANA SYSTEM) =====

model Challenge {
  id                String    @id @default(cuid())
  battleId          String?
  attackerId        String
  defenderId        String
  exercise          String // "squats" | "pushups" | "plank" | "burpees" | "jumps"
  exerciseName      String // Russian display name
  targetReps        Int // Base target (e.g. 50 squats)
  attackerTarget    Int // Adjusted by equipment (easier if better gear)
  defenderTarget    Int // Adjusted by equipment
  manaCost          Int       @default(20)
  status            String    @default("pending") // "pending" | "active" | "completed" | "expired"
  attackerStartedAt DateTime? // Server-recorded start time (anti-cheat)
  defenderStartedAt DateTime?
  attackerDone      Boolean   @default(false)
  defenderDone      Boolean   @default(false)
  attackerTime      Int? // seconds to complete (server-computed)
  defenderTime      Int? // seconds to complete (server-computed)
  attackerVerified  Boolean   @default(false) // AI camera verification passed
  defenderVerified  Boolean   @default(false)
  winnerId          String?
  xpReward          Int       @default(30)
  trophyReward      Int       @default(20)
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  @@index([attackerId])
  @@index([defenderId])
  @@index([status])
}

// ===== JARVIS VOICE CONVERSATION SYSTEM =====

model ConversationSession {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contextSnapshot Json
  status          String                @default("active") // "active", "ended"
  endedAt         DateTime?
  createdAt       DateTime              @default(now())
  messages        ConversationMessage[]

  @@index([userId])
}

model ConversationMessage {
  id        String              @id @default(cuid())
  sessionId String
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user", "assistant"
  content   String
  actions   Json?
  createdAt DateTime            @default(now())

  @@index([sessionId])
}

model TravelPlan {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String
  dateFrom    DateTime  @db.Date
  dateTo      DateTime? @db.Date
  purpose     String?
  budget      Float?
  currency    String    @default("₸")
  status      String    @default("planning") // "planning", "booked", "in_progress", "completed"
  flights     Json?
  hotels      Json?
  routes      Json?
  packingList Json?
  documents   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model ContactCache {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneId    String
  name       String
  phone      String?
  email      String?
  birthday   DateTime? @db.Date
  lastSynced DateTime  @default(now())

  @@unique([userId, phoneId])
  @@index([userId, name])
}

model DocumentVault {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "passport", "id_card", "driver_license", "insurance", "visa"
  title     String
  data      Json
  imageUri  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ===== COMPETITIVE FEATURES: TAGS, DEPENDENCIES, SHARED SPACES =====

model TaskDependency {
  id                 String @id @default(cuid())
  dependentTaskId    String
  dependentTask      Task   @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  prerequisiteTaskId String
  prerequisiteTask   Task   @relation("PrerequisiteTask", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, prerequisiteTaskId])
}

model Tag {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  taskTags  TaskTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
}

model SharedSpace {
  id        String              @id @default(cuid())
  name      String
  ownerId   String
  owner     User                @relation("OwnedSpaces", fields: [ownerId], references: [id])
  createdAt DateTime            @default(now())
  members   SharedSpaceMember[]
  tasks     Task[]
}

model SharedSpaceMember {
  id            String      @id @default(cuid())
  sharedSpaceId String
  sharedSpace   SharedSpace @relation(fields: [sharedSpaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String      @default("member")
  joinedAt      DateTime    @default(now())

  @@unique([sharedSpaceId, userId])
}

// JARVIS long-term memory: факты/решения/события/предпочтения, извлечённые
// из диктофона, чатов и разговоров. Используется для retrieval-augmented
// контекста: на каждый запрос к ассистенту подмешиваем релевантные воспоминания.
// Фаза 2 добавит embedding (pgvector) — пока чисто структурированное хранилище
// с тегами и важностью для упрощённого поиска.
model Memory {
  id         String                      @id @default(cuid())
  userId     String
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "fact" | "decision" | "event" | "person" | "place" | "preference" | "emotion"
  type       String
  // Короткая суть ("Серик переехал в Астану", "Решили встретиться в субботу")
  content    String
  // Развёрнутый контекст если нужен
  details    String?
  // "dictation" | "chat" | "voice" | "manual" | "import"
  source     String
  // ID исходной записи (DictationSession.id, ChatMessage.id и т.д.)
  sourceId   String?
  // Теги для фильтрации ("family", "work", "health", "travel")
  tags       String[]
  // 1-10, насколько важно. Используется при выборе top-K для контекста.
  importance Int                         @default(5)
  // Некоторые факты устаревают (например "завтра встреча")
  expiresAt  DateTime?
  // Phase 2.3: семантический эмбеддинг (Voyage voyage-3-lite, 512d).
  // Тип pgvector — Prisma его нативно не знает, поэтому Unsupported:
  // читаем/пишем только через $queryRaw/$executeRaw. NULL у старых
  // записей (досемантических) — гибридный ранкинг это учитывает.
  embedding  Unsupported("vector(512)")?
  createdAt  DateTime                    @default(now())
  // v2.0 — Episodic extension (validity windows + entity refs + mood)
  validAt    DateTime                    @default(now())
  invalidAt  DateTime?
  entityRefs String[]                    @default([])
  mood       Float?

  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([userId, importance])
  @@index([userId, validAt])
  @@index([userId, invalidAt])
}

// Запись сессии диктофона: транскрипт + что из него извлекли.
// Хранится как audit trail — можно вернуться и посмотреть исходник если
// AI-извлечение что-то упустило.
model DictationSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript      String
  // Краткая сводка от Claude: что записали, что создали
  summary         String?
  // Что Claude сказал юзеру вслух после обработки
  spokenResponse  String?
  tasksCreated    Int      @default(0)
  memoriesCreated Int      @default(0)
  durationSeconds Int?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// Phase 4.4: лог дисмиссов инсайтов. Append-only, без связи с User
// (минимальная правка; осиротевшие строки при удалении юзера
// безвредны — это адаптационный лог, не данные). Частота за окно
// понижает severity / глушит часто смахиваемые подсказки.
model InsightDismissal {
  id         String   @id @default(cuid())
  userId     String
  dismissKey String
  createdAt  DateTime @default(now())

  @@index([userId, dismissKey])
  @@index([userId, createdAt])
}

// SSOT migration Step 1: append-only audit of every executed tool.
// Single source of truth for "did this tool actually run". Badges,
// honesty tests and Step-0-class evidence read aggregates from here,
// never from LLM-generated text. Append-only, no User relation
// (orphan rows on user delete are harmless — this is an audit log,
// not user data), mirrors InsightDismissal precedent.
model ToolCall {
  id         String   @id @default(cuid())
  userId     String
  toolName   String
  inputJson  Json
  outputJson Json?
  durationMs Int
  error      String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, toolName, createdAt])
}

// SSOT migration Step 4 — confirm-FSM на Postgres (не in-memory
// singleton: тот терялся при рестарте Railway → юзер сказал «да»,
// а подтверждать уже нечего). Один pending на юзера (userId @unique:
// новое предложение перетирает старое). TTL 5 мин проверяется при
// чтении; протухшее удаляется лениво. Переживает рестарт процесса.
model PendingAction {
  userId           String   @id
  action           String
  inputJson        Json
  confirmationText String
  createdAt        DateTime @default(now())
}

// Phase 5 P1 — Insight (рефлектор). Что мозг подсветил, когда,
// насколько важно, что затрагивает, видел ли юзер, был ли полезен.
// Источник пушей/брифингов. userFeedback замыкает петлю обучения:
// часто not_useful → реже показывать (рефлектор не спамит).
// onDelete:Cascade — инсайты юзера уходят с юзером (не аудит-лог,
// в отличие от ToolCall).
model Insight {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  // 1..10 — для выбора top-1 в пуш (см. rate-limit рефлектора).
  severity        Int
  // Какие сущности затрагивает: { goals:[], habits:[], tasks:[], ... }.
  scope           Json
  message         String
  // Откуда вывод (для доверия/дебага, не всегда показывается юзеру).
  rationale       String?
  // Что мозг МОГ БЫ сделать: { action, input } — apply_insight
  // исполнит через обычный confirm-гейт реестра.
  suggestedAction Json?
  // Когда показан юзеру (null = ещё в feed, не доставлен).
  deliveredAt     DateTime?
  /// @deprecated P3/R2 SSOT: ЕДИНЫЙ feedback-стор = InsightDismissal
  /// + dismissKey (его уже использует proactive-insights Phase 4.4).
  /// userFeedback — параллельный механизм из P1, НЕ используем
  /// (дрейф, класс W4). НЕ дропаем (правило ISSUE-X: схема
  /// аддитивна до cutover migrate-deploy). Адаптация читает
  /// InsightDismissal по dismissKey, не это поле.
  userFeedback    String?
  dismissed       Boolean   @default(false)
  // P3/R2 — связь Insight с ЕДИНЫМ dismiss/adaptation-стором
  // (InsightDismissal). Рефлектор и плоский движок эмитят с
  // dismissKey; дисмисс через тот же routes/insights путь кормит
  // одну петлю обучения. Один источник правды, как isPlannerIntent.
  dismissKey      String?
  // P3/R5 P4-fold — поля ЕДИНОГО dispatch-ядра (insight-core).
  // Все nullable/без default → миграция аддитивна (ISSUE-X-safe).
  // kind — класс инсайта ('budget_over'|'weekly_goal_at_risk'|...);
  // scopeKey — СТАБИЛЬНЫЙ строковый ключ сущности ('budget:food',
  // 'goal:<id>') для cooldown/supersede (R9/R10); scope(Json)
  // остаётся для богатого контекста. source — откуда кандидат
  // (proactive_notifications|proactive_insights|reflector):
  // аналитика/кост/debug/ML — дёшево добавить сейчас, дорого потом.
  // expiresAt — TTL (R9); supersededAt — погашен новым того же
  // scopeKey+kind вне cooldown (R9), != deliveredAt/dismissed.
  kind            String?
  scopeKey        String?
  source          String?
  expiresAt       DateTime?
  supersededAt    DateTime?

  // Лента: новые сверху.
  @@index([userId, createdAt])
  // Очередь на доставку: недоставленные, по важности.
  @@index([userId, deliveredAt, severity])
  // R9/R10 — активные того же kind+scopeKey (cooldown/supersede).
  @@index([userId, kind, scopeKey])
}

// v2.0 — Tier 3 Semantic + Entity Graph
model Entity {
  id           String                      @id @default(cuid())
  userId       String
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String // 'person' | 'place' | 'concept' | 'goal' | 'organization'
  name         String
  aliases      String[]                    @default([])
  attributes   Json                        @default("{}")
  lastSeenAt   DateTime                    @default(now())
  baselineFreq Float                       @default(0)
  moodAvg      Float?
  importance   Int                         @default(5)
  embedding    Unsupported("vector(512)")?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  relsFrom EntityRelationship[] @relation("FromEntity")
  relsTo   EntityRelationship[] @relation("ToEntity")

  @@unique([userId, type, name])
  @@index([userId, type])
  @@index([userId, lastSeenAt])
  @@index([userId, importance])
}

model EntityRelationship {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromId    String
  from      Entity    @relation("FromEntity", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Entity    @relation("ToEntity", fields: [toId], references: [id], onDelete: Cascade)
  type      String // 'family'|'friend'|'colleague'|'partner'|'concern'|'goal_link'|'location'|'works_at'|'lives_in'|'connected_to'
  label     String?
  strength  Float     @default(0.5)
  validAt   DateTime  @default(now())
  invalidAt DateTime?
  createdAt DateTime  @default(now())
  // Fix 2026-05-28 (code-review): strength evolves over time (relationships
  // strengthen/weaken). updatedAt даёт audit trail когда strength changed.
  updatedAt DateTime  @updatedAt

  @@unique([userId, fromId, toId, type, validAt])
  @@index([userId, fromId])
  @@index([userId, toId])
}

// v2.0 — Tier 4 Procedural mini
model Pattern {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String // 'frequency'|'time_of_day'|'recurring_topic'|'commitment'|'streak_break'
  description    String
  payload        Json
  confidence     Float     @default(0)
  observations   Int       @default(1)
  lastObservedAt DateTime  @default(now())
  validAt        DateTime  @default(now())
  invalidAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, kind])
  @@index([userId, confidence])
  @@index([userId, validAt, invalidAt])
}

// v2.0 — Tier 5 Emotional
model MoodSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source     String // 'message'|'daily_agg'
  sourceId   String?
  valence    Float
  arousal    Float    @default(0.5)
  emotion    String // 'sad'|'anxious'|'happy'|'angry'|'neutral'|'mixed'
  entityRefs String[] @default([])
  excerpt    String?
  recordedAt DateTime @default(now())
  // Fix 2026-05-28 (code-review): daily_agg rows будут recomputed (cron
  // weekly aggregation). updatedAt = audit trail когда снимок пересчитан.
  updatedAt  DateTime @updatedAt

  @@index([userId, recordedAt])
  @@index([userId, emotion])
}

// v2.0 — Tier 5 Identity mini
model BotIdentity {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  botName   String   @default("Эля")
  avatar    String   @default("🤍")
  style     String   @default("friendly")
  traits    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────────
// v2 Phase B2 — Identity Evolution: weekly snapshots of BOT traits.
// Spec: docs/superpowers/specs/2026-05-31-v2-phase-b2-identity-evolution-design.md
// BotIdentity.traits (existing Json) holds CURRENT traits; these snapshots
// power the growth narrative (compare oldest vs current).
// ───────────────────────────────────────────────────────────────────────────

model BotTraitSnapshot {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  warmth      Float
  directness  Float
  humor       Float
  playfulness Float
  depth       Float
  recordedAt  DateTime @default(now())

  @@index([userId, recordedAt])
}

// v2.0 Week 6 (spec §9.6) — cron job audit log used for idempotency.
// Single tiny model shared by mood-retention-cron + pattern-extraction-cron.
// withCronLock(jobName, intervalMs, userId, fn) writes one row per successful
// run; "did this run recently?" = findFirst order by ranAt desc.
// No FK on userId — audit row stays even if user deleted (purely historical).
model CronJobRun {
  id      String   @id @default(cuid())
  jobName String
  userId  String?
  ranAt   DateTime @default(now())
  // 2.1 (AUDIT-2026-06): атомарный claim-ключ "job:user:периодБакет".
  // unique → конкурентные тики/инстансы гонят на insert, выигрывает один.
  lockKey String?  @unique

  @@index([jobName, ranAt])
  @@index([userId, jobName, ranAt])
}

// 2.3 (AUDIT-2026-06): durable дневной AI-бюджет (per-user). Раньше счётчик
// жил в in-memory Map → терялся при рестарте и не шарился между инстансами
// (единственный гард стоимости Claude «течёт»). Теперь — Postgres, атомарный
// upsert-increment. Одна строка на (userId, день).
model AiUsageDaily {
  userId String
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, day])
}

// ───────────────────────────────────────────────────────────────────────────
// v2 Phase B1 — USER NEST Axes (added 2026-05-31)
// Spec: docs/superpowers/specs/2026-05-31-v2-phase-b1-user-axes-design.md
// ───────────────────────────────────────────────────────────────────────────

model UserAxes {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 4 axes, all Float in [0, 1], default 0.5 (neutral)
  selfDiscipline     Float @default(0.5)
  emotionalOpenness  Float @default(0.5)
  conflictTolerance  Float @default(0.5)
  introspectionDepth Float @default(0.5)

  // Provenance
  signalCount  Int       @default(0)
  lastSignalAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model AxisSignal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  msgId      String?
  axis       String
  delta      Float
  confidence Float    @default(0.5)
  excerpt    String?
  source     String   @default("claude_classifier")
  recordedAt DateTime @default(now())

  @@index([userId, axis, recordedAt])
  @@index([userId, recordedAt])
  @@index([msgId])
}

// v2.0 Phase B3 — Cross-Session Learning: feedback-loop audit log.
// Records every detected correction signal so the feedback-detector
// service can review, tune, and replay signals without touching raw chat.
model CorrectionLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  userMsgId      String?
  botExcerpt     String
  userExcerpt    String
  signalType     String   // 'explicit' | 'mood_drop' | 're_ask'
  valence        String   // 'positive' | 'negative' | 'neutral'
  dimension      String   // 'tone' | 'content' | 'understanding' | 'style'
  appliedSignals Json
  styleNote      String?
  moodDelta      Float?
  reaskSim       Float?
  recordedAt     DateTime @default(now())

  @@index([userId, recordedAt])
}

// v2.0 Phase B4 — Hermes composable skills: learnable, executable skill cards.
model SkillDefinition {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  description String
  triggers    String[]
  plan        Json
  embedding   Json?
  synthesis   String
  source      String    // 'proactive' | 'explicit'
  active      Boolean   @default(true)
  useCount    Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, name])
  @@index([userId, active])
}
