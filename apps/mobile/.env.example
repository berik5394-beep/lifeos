# ==== LifeOS Mobile — Environment Variables ====
# Скопируй этот файл в .env и заполни значения.
# cp .env.example .env

# URL backend-сервера. В локальной разработке — IP твоего Mac в локальной сети.
EXPO_PUBLIC_API_URL=http://172.20.10.4:3000

# Google Calendar OAuth Client ID.
# Как получить:
# 1. Заходишь на https://console.cloud.google.com
# 2. APIs & Services → Credentials → Create Credentials → OAuth Client ID
# 3. Application type: iOS (для iPhone) или Web application
# 4. Authorized redirect URIs: https://auth.expo.io/@your-expo-username/lifeos
# 5. Скопируй Client ID сюда:
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# (опционально) Anthropic API key для Claude Vision на клиенте.
# Обычно вызовы идут через backend, так что оставь пустым.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
